{
  "name": "requirement-pulse",
  "version": "0.1.0",
  "description": "Requirement Pulse — a local-first requirement decision board with an agent analysis bridge.",
  "main": "./out/main/index.js",
  "author": "Harvey Xia",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/harveyxiacn/requirement-pulse",
  "repository": {
    "type": "git",
    "url": "https://github.com/harveyxiacn/requirement-pulse.git"
  },
  "keywords": [
    "electron",
    "kanban",
    "requirements",
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "local-first"
  ],
  "scripts": {
    "dev": "npm run mcp:build && electron-vite dev",
    "start": "electron-vite preview",
    "mcp:build": "node scripts/build-mcp.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "test": "npm run mcp:build && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run mcp:build && npm run typecheck && electron-vite build",
    "dist:win": "npm run build && electron-builder --win --x64",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "cmdk": "^1.1.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.81.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.7",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "zustand": "^5.1.0"
  }
}
